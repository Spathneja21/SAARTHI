# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
# core/database.py calls load_dotenv() at import time and reads DATABASE_URL with
# NO default — if it is unset the app raises before serving a single request.

# Postgres. Use `localhost` when running uvicorn on the host against the compose
# database; use `db` (the service name) when the API itself runs inside compose.
DATABASE_URL=postgresql+asyncpg://aura_user:aura_pass@localhost:5432/aura_db

# Redis, for Celery. Only needed by the worker/beat containers and the three
# /ml/retrain, /ml/update-profiles and /ml/task-status endpoints. The API serves
# auth, tasks, scheduling and predictions without it.
REDIS_URL=redis://localhost:6379/0

# Firebase Admin service-account key, used to verify the ID tokens the Flutter app
# sends. Download from: Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key", for project `saarthi-931dd`.
# Keep it in secrets/ (gitignored and dockerignored).
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# Log every SQL statement. Useful when debugging a query, very noisy otherwise.
SQL_ECHO=false
